<header class="site-header">
  <nav class="container site-nav" aria-label="メインナビゲーション">
    <a class="site-brand" href="{{ '/' | relative_url }}">{{ site.title }}</a>
    <button class="menu-toggle" type="button" aria-controls="site-navigation" aria-expanded="false" aria-label="メニューを開く">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <span>メニュー</span>
    </button>
    <div class="site-navigation" id="site-navigation" data-expanded="false">
      <ul class="site-nav-links">
        <li>
          <a
            href="{{ '/' | relative_url }}"
            {% if page.permalink == '/' %}
              aria-current="page"
            {% endif %}
            >Home</a
          >
        </li>
        {% assign sorted_pages = site.pages | sort: 'nav_order' %}
        {% for p in sorted_pages %}
          {% if p.nav and p.autogen == null and p.permalink != '/' %}
            {% assign parent_link = p.permalink | remove: 'index.html' %}
            <li>
              <a
                href="{{ p.url | relative_url }}"
                {% if page.url contains parent_link %}
                  aria-current="page"
                {% endif %}
              >
                {{- p.title -}}
              </a>
            </li>
          {% endif %}
        {% endfor %}
        {% if site.search_enabled %}
          <li>
            <button id="search-toggle" type="button" aria-label="サイト内を検索" onclick="openSearchModal()">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 4 4"></path>
              </svg>
              <span class="sr-only">検索</span>
            </button>
          </li>
        {% endif %}
      </ul>
    </div>
    <fieldset class="palette-switch">
      <legend class="sr-only">サイトの配色</legend>
      <label
        ><input type="radio" name="palette" value="latte" checked
        ><span><span class="palette-dot palette-dot--latte" aria-hidden="true"></span>ラテ</span></label
      >
      <label
        ><input type="radio" name="palette" value="mocha"
        ><span><span class="palette-dot palette-dot--mocha" aria-hidden="true"></span>モカ</span></label
      >
      <label
        ><input type="radio" name="palette" value="espresso"
        ><span><span class="palette-dot palette-dot--espresso" aria-hidden="true"></span>エスプレッソ</span></label
      >
    </fieldset>
  </nav>
</header>
