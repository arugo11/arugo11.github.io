<footer class="site-footer">
  <div class="container">
    <p>
      &copy; Copyright {{ site.time | date: '%Y' }}
      {{ site.first_name }}
      {{ site.middle_name }}
      {{ site.last_name }}. {{ site.footer_text }}
      {% if site.impressum_path -%}
        <a href="{{ site.impressum_path | relative_url }}">Impressum</a>.
      {%- endif %}
      {% if site.last_updated %}最終更新: {{ 'now' | date: '%Y-%m-%d' }}.{% endif %}
    </p>
  </div>
</footer>
