---
layout: default
---
{% assign home_projects = site.projects | where_exp: 'project', 'project.home_order' | sort: 'home_order' %}
{% assign visible_posts = site.posts | where_exp: 'post', 'post.hidden != true' %}

<div class="portfolio-shell">
  <section class="portfolio-masthead" aria-labelledby="intro-title">
    <div class="portfolio-masthead__main">
      <h1 id="intro-title" class="portfolio-masthead__title">
        {{ page.hero_title -}}
        <span aria-hidden="true">.</span>
      </h1>
      <p class="portfolio-kicker">{{ page.hero_label }}</p>
      <p class="portfolio-masthead__summary">{{ page.hero_summary }}</p>
      <p class="portfolio-masthead__lead">{{ page.subtitle }}</p>
      <div class="portfolio-masthead__actions">
        <a class="primary-action" href="{{ '/projects/' | relative_url }}">プロジェクト一覧 <span aria-hidden="true">→</span></a>
        <a class="secondary-action" href="{{ '/cv/' | relative_url }}">CV</a>
        <a class="text-action" href="mailto:{{ site.email }}">メールする</a>
      </div>
    </div>
    <section class="profile-panel" aria-labelledby="profile-heading">
      <div class="profile-panel__intro">
        <img src="{{ '/assets/img/icon.jpg' | relative_url }}" width="200" height="200" alt="Argo のプロフィールアイコン" fetchpriority="high">
        <h2 id="profile-heading">Hello, I’m Argo.</h2>
      </div>
      <div class="profile-panel__body">{{ content }}</div>
      <ul class="profile-interests" aria-label="関心分野">
        <li>LLM</li>
        <li>Robotics</li>
        <li>Math</li>
      </ul>
    </section>
  </section>

  <section class="portfolio-block" aria-labelledby="works-heading">
    <div class="section-heading">
      <div>
        <p class="portfolio-kicker">Selected works</p>
        <h2 id="works-heading">主要実績</h2>
      </div>
      <p>受賞や発表を含めて、今の関心や役割が伝わるものを先に並べています。</p>
    </div>
    <div class="portfolio-grid">
      {% for project in home_projects -%}
        {%- include project-card.liquid project=project -%}
      {%- endfor %}
    </div>
    <a class="section-link" href="{{ '/projects/' | relative_url }}">すべてのプロジェクトを見る <span aria-hidden="true">→</span></a>
  </section>

  <section class="portfolio-notes" aria-labelledby="notes-heading">
    <div class="section-heading">
      <div>
        <p class="portfolio-kicker">Zines & notes</p>
        <h2 id="notes-heading">更新履歴</h2>
      </div>
    </div>
    <div class="notes-grid">
      {% for post in visible_posts limit: 3 %}
        <a class="note-card" href="{{ post.url | relative_url }}">
          <span class="note-card__icon" aria-hidden="true">↗</span>
          <div>
            <time datetime="{{ post.date | date_to_xmlschema }}">{{ post.date | date: '%Y.%m.%d' }}</time>
            <h3>{{ post.title }}</h3>
          </div>
          <span aria-hidden="true">→</span>
        </a>
      {% endfor %}
    </div>
  </section>

  {% if page.news and site.announcements.enabled %}
    <section class="portfolio-block" aria-labelledby="news-heading">
      <div class="section-heading">
        <div>
          <p class="portfolio-kicker">近況</p>
          <h2 id="news-heading">最近のトピック</h2>
        </div>
      </div>
      {% include news.liquid limit=true %}
    </section>
  {% endif %}

  {% if page.social %}
    <section class="portfolio-contact" aria-labelledby="contact-heading">
      <div>
        <h2 id="contact-heading">連絡先</h2>
        <p>{{ site.contact_note }}</p>
      </div>
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>
      </div>
    </section>
  {% endif %}
</div>
